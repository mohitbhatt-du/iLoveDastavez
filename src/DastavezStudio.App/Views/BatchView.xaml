<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.Views.BatchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App.Views"
    xmlns:vm="using:DastavezStudio.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="32,24,32,32" MaxWidth="1100" HorizontalAlignment="Left">
            
            <StackPanel Spacing="4">
                <TextBlock Text="Batch Processing Queue" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Bulk process multiple student documents or applicant photographs simultaneously with bounded concurrency." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Actions Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Add Files..." Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Add Folder..." />
                        <Button Content="Clear List" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button Content="Start Processing" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Cancel" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}" Maximum="100" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
