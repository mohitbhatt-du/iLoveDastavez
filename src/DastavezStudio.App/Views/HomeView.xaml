<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App.Views"
    xmlns:vm="using:DastavezStudio.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="32,24,32,32" MaxWidth="1100" HorizontalAlignment="Left">
            
            <!-- Hero Header -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="4"
                            VerticalAlignment="Center">
                        <Image x:Name="HeroLogo" Width="84" Height="84" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="iLoveDastavez" 
                                       Style="{StaticResource TitleTextBlockStyle}" 
                                       FontWeight="Bold" 
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="— Dastavez Studio" 
                                       Style="{StaticResource TitleTextBlockStyle}" 
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="हर दस्तावेज़, तैयार! — Complete Offline Document &amp; Image Toolkit" 
                                   Style="{StaticResource SubtitleTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Tailored for IBPS, SBI, SSC, UPSC, RRB, NTA and government competitive exam candidates with strict upload rules." 
                                   Style="{StaticResource BodyTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- Offline Badge -->
                    <Border Grid.Column="2" 
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="16" />
                            <TextBlock Text="100% Offline Secured" 
                                       FontWeight="SemiBold" 
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Quick Action Cards Section -->
            <StackPanel Spacing="4">
                <TextBlock Text="Quick Actions" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Select a studio tool to jump right in:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <GridView ItemsSource="{x:Bind ViewModel.QuickActions}"
                      IsItemClickEnabled="True"
                      ItemClick="OnQuickActionItemClick"
                      SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickActionItem">
                        <Border Width="310" Height="140"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,12,12">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" 
                                           Margin="0,10,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Drag and Drop Dropzone -->
            <TextBlock Text="Quick File Drop" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
            
            <Border x:Name="DropZone"
                    AllowDrop="True"
                    DragOver="OnDropZoneDragOver"
                    DragLeave="OnDropZoneDragLeave"
                    Drop="OnDropZoneDrop"
                    PointerPressed="OnDropZoneClicked"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="40"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon x:Name="DropZoneIcon" Glyph="&#xE898;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DropZoneTitle" Text="Drag and drop documents or images here (or click to browse)" 
                               Style="{StaticResource BodyStrongTextBlockStyle}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Supports PDF, JPEG, PNG, WEBP, BMP, and TIFF. Processed 100% locally with zero cloud uploads." 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
