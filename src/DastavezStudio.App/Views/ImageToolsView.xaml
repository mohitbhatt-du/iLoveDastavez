<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.Views.ImageToolsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App.Views"
    xmlns:conv="using:DastavezStudio.App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="32,24,32,32" MaxWidth="1140" HorizontalAlignment="Left">
            
            <StackPanel Spacing="4">
                <TextBlock Text="Image Toolkit" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Precision pixel resizing, iterative target KB compression, DPI formatting, and metadata privacy scrubbing with live preview." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Configuration Grid -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <!-- Dimensions & Resizing -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Dimension Controls" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="6" Width="140">
                                <TextBlock Text="Width (px)" Style="{StaticResource CaptionTextBlockStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.TargetWidth, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Spacing="6" Width="140">
                                <TextBlock Text="Height (px)" Style="{StaticResource CaptionTextBlockStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.TargetHeight, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox Content="Preserve Aspect Ratio" IsChecked="{x:Bind ViewModel.MaintainAspectRatio, Mode=TwoWay}" />
                        
                        <StackPanel Spacing="6">
                            <TextBlock Text="Target DPI" Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.TargetDpi, Mode=TwoWay}" SpinButtonPlacementMode="Inline" Minimum="72" Maximum="600" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Compression & Format -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Compression &amp; Format" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        
                        <StackPanel Spacing="6">
                            <TextBlock Text="Target File Size Limit (KB)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.TargetSizeKb, Mode=TwoWay}" SpinButtonPlacementMode="Inline" Minimum="5" Maximum="5000" />
                            <TextBlock Text="Iteratively encodes image to fit below this limit" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Output Format" Style="{StaticResource CaptionTextBlockStyle}" />
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="JPEG / JPG (Recommended for Exam Portals)" />
                                <ComboBoxItem Content="PNG (Lossless)" />
                                <ComboBoxItem Content="WEBP (Modern Web)" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Strip EXIF / Privacy Metadata" IsChecked="{x:Bind ViewModel.StripExif, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- LIVE PREVIEW CONTAINER (SIDE-BY-SIDE: BEFORE vs AFTER) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <!-- Original Image Preview -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Source Image" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.OriginalDimensions, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.OriginalFileSize, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Height="280"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.SourceImage, Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No source image loaded" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click Select Source Image below" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.InputFileName, Mode=OneWay, FallbackValue='No image selected'}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Processed Image Preview -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Live Processed Preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasProcessedImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind ViewModel.ProcessedDimensions, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind ViewModel.ProcessedFileSize, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Height="280"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.ProcessedImage, Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasProcessedImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasProcessedImage, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                                    <FontIcon Glyph="&#xE790;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Processed Preview" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Adjust settings and click Process Image to preview" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4" Padding="8,2"
                                    Visibility="{x:Bind ViewModel.HasProcessedImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Ready ✓" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- File Status & Actions Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button Content="Select Source Image..." 
                                Click="OnSelectFileClicked" 
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Process Image" 
                                Command="{x:Bind ViewModel.ProcessImageCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSourceImage, Mode=OneWay}" />
                        <Button Content="Export &amp; Save" 
                                Click="OnExportClicked"
                                IsEnabled="{x:Bind ViewModel.HasProcessedImage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
