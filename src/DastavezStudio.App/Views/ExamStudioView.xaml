<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.Views.ExamStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App.Views"
    xmlns:models="using:DastavezStudio.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="32,24,32,32" MaxWidth="1100" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Exam Document Studio" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Prepare photographs, signatures, declarations and certificates to exact examination guidelines." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Selection Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                    <!-- Authority Picker -->
                    <StackPanel Spacing="6" Width="220">
                        <TextBlock Text="Examination Authority" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Authorities}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAuthority, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Preset Picker -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Document Requirement Preset" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.FilteredPresets}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ExamPreset">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind ExamName}" FontWeight="SemiBold" />
                                        <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind DocumentType}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Import Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button Click="OnSelectFileClicked" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Browse File" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preset Specifications Info Card -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,*,*,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Target Dimensions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.SelectedPreset.RequiredWidthPx, Mode=OneWay}" />
                            <Run Text=" × " />
                            <Run Text="{x:Bind ViewModel.SelectedPreset.RequiredHeightPx, Mode=OneWay}" />
                            <Run Text=" px" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Allowed File Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.SelectedPreset.MinSizeKb, Mode=OneWay}" />
                            <Run Text=" KB – " />
                            <Run Text="{x:Bind ViewModel.SelectedPreset.MaxSizeKb, Mode=OneWay}" />
                            <Run Text=" KB" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Allowed Formats" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPreset.AllowedFormats, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Target DPI" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.SelectedPreset.TargetDpi, Mode=OneWay}" />
                            <Run Text=" DPI" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Instructions Notice -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Authority Requirement Note"
                     Message="{x:Bind ViewModel.SelectedPreset.AdditionalInstructions, Mode=OneWay}" />

            <!-- Active Document & Compliance Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.InputFileName, Mode=OneWay, FallbackValue='No document loaded'}" 
                                       Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.InputFilePath, Mode=OneWay, FallbackValue='Select or drop an exam document to inspect and format'}" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Banner -->
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- Action Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Auto-Conform to Preset" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Crop / Adjust Ratio" />
                        <Button Content="Compress to Target KB" />
                        <Button Content="Export &amp; Save" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
