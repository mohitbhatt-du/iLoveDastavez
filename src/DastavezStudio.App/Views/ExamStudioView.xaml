<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.Views.ExamStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App.Views"
    xmlns:models="using:DastavezStudio.Core.Models"
    xmlns:conv="using:DastavezStudio.App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="32,24,32,32" MaxWidth="1140" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Exam Document Studio" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Prepare photographs, signatures, declarations and certificates to exact examination guidelines with real-time live preview." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Selection Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                    <!-- Authority Picker -->
                    <StackPanel Spacing="6" Width="220">
                        <TextBlock Text="Examination Authority" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Authorities}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAuthority, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Preset Picker -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Document Requirement Preset" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.FilteredPresets}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ExamPreset">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind ExamName}" FontWeight="SemiBold" />
                                        <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind DocumentType}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Import Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button Click="OnSelectFileClicked" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Browse File" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preset Specifications Info Card -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,*,*,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Target Dimensions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.SelectedPreset.RequiredWidthPx, Mode=OneWay}" />
                            <Run Text=" × " />
                            <Run Text="{x:Bind ViewModel.SelectedPreset.RequiredHeightPx, Mode=OneWay}" />
                            <Run Text=" px" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Allowed File Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.SelectedPreset.MinSizeKb, Mode=OneWay}" />
                            <Run Text=" KB – " />
                            <Run Text="{x:Bind ViewModel.SelectedPreset.MaxSizeKb, Mode=OneWay}" />
                            <Run Text=" KB" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Allowed Formats" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPreset.AllowedFormats, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Target DPI" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.SelectedPreset.TargetDpi, Mode=OneWay}" />
                            <Run Text=" DPI" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LIVE PREVIEW WORKBENCH (SIDE-BY-SIDE: ORIGINAL vs CONFORMED) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                
                <!-- Left: Original Source Document -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Original Document" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.SourceDimensions, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.SourceFileSize, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Preview Canvas -->
                        <Border Grid.Row="1" Height="300"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Grid>
                                <!-- Image Preview -->
                                <Image Source="{x:Bind ViewModel.SourceImage, Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <!-- Empty State Placeholder -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No document loaded" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Browse or drag a photo/signature to view" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Original Document File Name -->
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.InputFileName, Mode=OneWay, FallbackValue='Awaiting file selection'}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Right: Conformed Live Output Preview -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Live Conformed Preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasConformedImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind ViewModel.ConformedDimensions, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind ViewModel.ConformedFileSize, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.ConformedDpi, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Preview Canvas with Aspect Ratio Guide -->
                        <Border Grid.Row="1" Height="300"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Grid>
                                <!-- Conformed Image Preview -->
                                <Image Source="{x:Bind ViewModel.ConformedImage, Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasConformedImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <!-- Empty State Placeholder -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasConformedImage, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                                    <FontIcon Glyph="&#xE790;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Conformed Preview" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Real-time upload-ready output will render here" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Conformed Output Status Tag -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4" Padding="8,2"
                                    Visibility="{x:Bind ViewModel.HasConformedImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Upload-Ready ✓" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Instructions Notice -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Authority Requirement Note"
                     Message="{x:Bind ViewModel.SelectedPreset.AdditionalInstructions, Mode=OneWay}" />

            <!-- Action Controls Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <!-- Action Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button Content="Auto-Conform to Preset" 
                                Command="{x:Bind ViewModel.AutoConformCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.HasSourceImage, Mode=OneWay}" />
                        <Button Content="Re-Validate" 
                                Command="{x:Bind ViewModel.ValidateCurrentFileCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSourceImage, Mode=OneWay}" />
                        <Button Content="Export &amp; Save" 
                                Click="OnExportClicked"
                                IsEnabled="{x:Bind ViewModel.HasConformedImage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
