<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.Views.AiEnhanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App.Views"
    xmlns:vm="using:DastavezStudio.App.ViewModels"
    xmlns:conv="using:DastavezStudio.App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:InverseBoolConverter x:Key="InvBool" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="32,24,32,32" MaxWidth="1100" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Offline AI Enhancement &amp; Upscaling" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Local neural inference &amp; super-resolution algorithms running 100% on device with zero internet access." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Offline Guarantee InfoBar -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Strict Privacy &amp; Offline Guarantee"
                     Message="Processing runs exclusively on your local CPU / GPU. No document or photograph ever leaves your PC." />

            <!-- Configuration Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Enhancement Settings &amp; Acceleration" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="24">
                        <!-- Upscaling Factor -->
                        <StackPanel Spacing="6" Width="220">
                            <TextBlock Text="Super-Resolution Factor" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedUpscaleIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="2× Super-Resolution" Tag="2" />
                                <ComboBoxItem Content="4× Super-Resolution" Tag="4" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Hardware Provider -->
                        <StackPanel Grid.Column="1" Spacing="6" Width="260">
                            <TextBlock Text="Execution Hardware" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.HardwareProviders}"
                                      SelectedItem="{x:Bind ViewModel.SelectedHardwareProvider, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Toggles -->
                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Bottom">
                            <CheckBox Content="Artifact Denoising" IsChecked="{x:Bind ViewModel.Denoise, Mode=TwoWay}" />
                            <CheckBox Content="Edge Sharpening" IsChecked="{x:Bind ViewModel.Sharpen, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="8" VerticalAlignment="Bottom">
                            <CheckBox Content="Adaptive Contrast" IsChecked="{x:Bind ViewModel.EnhanceContrast, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Document Selection & Action Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB9F;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.InputFileName, Mode=OneWay, FallbackValue='No image selected'}" 
                                       Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.InputFilePath, Mode=OneWay, FallbackValue='Select a photo, signature or certificate to enhance'}" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2" Click="OnSelectFileClicked" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvBool}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Select Image..." />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Progress Bar -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" />
                    </StackPanel>

                    <!-- Status Text -->
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- Result Banner if enhanced -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasEnhancedFile, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Success"
                             Title="Enhancement Complete"
                             Message="{x:Bind ViewModel.ResultDetails, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="Save Enhanced Image..." Click="OnExportClicked" Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Action Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Run AI Enhancement"
                                Command="{x:Bind ViewModel.RunEnhanceCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.HasInputFile, Mode=OneWay}" />

                        <Button Content="Cancel"
                                Command="{x:Bind ViewModel.CancelEnhanceCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

                        <Button Content="Export Enhanced..."
                                Click="OnExportClicked"
                                IsEnabled="{x:Bind ViewModel.HasEnhancedFile, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
