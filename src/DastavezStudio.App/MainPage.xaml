<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DastavezStudio.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DastavezStudio.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged"
                        Loaded="OnNavViewLoaded">
            
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,14,16,14" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Dastavez Studio" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Exam Document Studio" Tag="ExamStudio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="PDF Tools" Tag="PdfTools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Image Tools" Tag="ImageTools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Batch Processing" Tag="Batch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA37;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="OCR &amp; Scanner" Tag="ScannerOcr">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE892;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="AI Enhancement" Tag="AiEnhance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Main Content Area with Bottom Footer Bar -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" />

                <!-- Persistent Status & Authority Badges Footer -->
                <Border Grid.Row="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        
                        <!-- Brand Identity & Tagline -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.BrandName}" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" />
                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.Tagline}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>

                        <!-- Supported Exam Authority Logos with Hover & Tooltips -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Exam Presets:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/ibps.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="Institute of Banking Personnel Selection (IBPS)" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/sbi.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="State Bank of India (SBI)" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/ssc.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="Staff Selection Commission (SSC)" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/upsc.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="Union Public Service Commission (UPSC)" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/rrb.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="Railway Recruitment Board (RRB)" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/nta.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="National Testing Agency (NTA)" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="3,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="Assets/Logos/psc.png" Height="20" Stretch="Uniform" ToolTipService.ToolTip="State Public Service Commissions (PSC)" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Offline Security Status & Version -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="12" />
                                <TextBlock Text="100% Offline" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Version}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                    </Grid>
                </Border>

            </Grid>

        </NavigationView>
    </Grid>
</Page>
